# Ignore everything by default.
*

# Keep this ignore file.
!.gitignore

# Keep root Python source and plugin metadata/docs.
!*.py
!__init__.py
!build.ps1
!plugin.json
!requirements.txt
!README.md
!scripts/
!scripts/**

# Keep runtime assets, binaries, and KiCad plugin Python sources.
!assets/
!assets/**
!legacy/
!legacy/**
!plugin/
!plugin/**
!docs/
!docs/**
