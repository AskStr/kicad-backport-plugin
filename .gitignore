# Ignore everything by default.
*

# Keep this ignore file.
!.gitignore

# Keep Python source, packaging scripts, and project metadata/docs.
!*.py
!plugin.json
!requirements.txt
!requirements-dev.txt
!LICENSE
!README.md

# Keep runtime assets, binaries, plugin sources, and supporting files.
!assets/
!assets/**
!legacy/
!legacy/**
!plugin/
!plugin/**
!docs/
!docs/**
!scripts/
!scripts/**

# Keep PCM release tooling, schema snapshots, and regression tests.
!pcm/
!pcm/**
!tests/
!tests/**

# Final exclusions must stay AFTER all allowlist rules above.
# Ignore generated PCM repository output.
/pcm/repository/

# Ignore Python cache directories and bytecode at every depth.
__pycache__/
*.pyc
*.pyo
